# Razorpay checkout key — backend ke RAZORPAY_KEY_ID ke saath match karni hogi,
# warna order account aur checkout account alag ho jayenge (payment fail).
VITE_RAZORPAY_KEY=rzp_test_ThMTYYg8cKKkDd

# Backend API base URL — /api suffix zaroori hai (routes /api/* par mount hote hain)
# Local backend:  http://localhost:3000/api
# Production:     https://storeitnow-cloud-1.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# Google Cloud Console > OAuth 2.0 Client IDs > Web application
# Authorized JavaScript origins: http://localhost:5173 + prod frontend URL
# Backend GOOGLE_CLIENT_ID ke SAME ID ko yahan bhi daalein.
VITE_GOOGLE_CLIENT_ID=668820137110-nirni9bbo9edk0ob35jrvm3ie33vrtfi.apps.googleusercontent.com
