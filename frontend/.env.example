# frontend/.env — is file ko apne machine par banao (ye example hai).
# Real `.env` gitignored hai aur repo me kabhi commit nahi hoti.

# Razorpay checkout key — backend ke RAZORPAY_KEY_ID ke saath match karni chahiye.
# (Ye public hoti hai — browser bundle me jaati hai.)
VITE_RAZORPAY_KEY=rzp_test_XXXXXXXXXXXXXXXX

# Backend API base URL — /api suffix zaroori hai (routes /api/* par mount hote hain)
# Local backend:        http://localhost:3000/api
# Production (Render):  https://<render-service>.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# Google Cloud Console > OAuth 2.0 Client IDs > Web application
# Ye Client ID PUBLIC hai (browser me jaata hai) — isliye yahan daalna safe hai.
# Authorized JavaScript origins me apna frontend URL add karna:
#   http://localhost:5173  +  https://<vercel-domain>
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
