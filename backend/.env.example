# Copy this file to .env and fill with real values. Do NOT commit secrets to git.

# ── Server ─────────────────────────────────────────────
PORT=3000
# CORS me frontend origin daalein (comma separated), e.g.
# http://localhost:5173,https://storeitnow-cloud-1.onrender.com
CORS_ORIGIN=

# ── Database ───────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/storeitnow

# ── Auth ───────────────────────────────────────────────
# NOTE: code JWT_SECRET_KEY padhta hai; JWT_SECRET bhi accepted hai (same value rakhein)
JWT_SECRET_KEY=your_jwt_secret_here
JWT_SECRET=your_jwt_secret_here

# Google Sign-In (Google Cloud Console > OAuth 2.0 Client IDs)
# Web application type, Authorized JavaScript origins:
#   http://localhost:5173
#   https://storeitnow-cloud-1.onrender.com
# Authorized redirect URIs (GIS button ke liye optional):
#   http://localhost:5173
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── File storage (ImageKit) ────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Payments (Razorpay) ────────────────────────────────
# Code RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET padhta hai
# (RAZORPAY_SECRET bhi RAZORPAY_KEY_SECRET ki tarah accept hota hai)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=

# ── Email (Nodemailer / Gmail app password) ────────────
EMAIL_USER=
EMAIL_PASS=
